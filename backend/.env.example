PROJECT_NAME="Cognitive Contract Intelligence & Risk Advisory System"
API_V1_STR="/api"
SECRET_KEY="temporary-dev-secret-key-change-in-production-12345678"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite by default, modular for PostgreSQL migration)
DATABASE_URL="sqlite:///D:/contract-intelligence/storage/contracts.db"

# Storage paths
STORAGE_BASE_DIR="D:/contract-intelligence/storage"
UPLOAD_DIR="D:/contract-intelligence/storage/uploads"
EXTRACTED_TEXT_DIR="D:/contract-intelligence/storage/extracted_text"
VECTOR_STORE_DIR="D:/contract-intelligence/storage/vector_store"
REPORTS_DIR="D:/contract-intelligence/storage/reports"

# AI Provider Configuration
# Supported providers: "gemini", "mock" (fallback when no API key)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OCR Settings
TESSERACT_PATH=""
